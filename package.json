{
  "name": "elchub-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun run dev:backend & bun run dev:frontend & wait",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend typecheck",
    "typecheck": "bun run typecheck:frontend && bun run typecheck:backend",
    "typecheck:frontend": "bun run --cwd frontend typecheck",
    "typecheck:backend": "bun run --cwd backend typecheck",
    "test": "bun run --cwd backend test",
    "test:preintegration": "bun run --cwd backend test:preintegration",
    "test:preintegration:auth": "bun run --cwd backend test:preintegration:auth",
    "check:preintegration": "bun run --cwd backend check:preintegration"
  }
}