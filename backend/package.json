{
  "name": "elchub-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "postinstall": "bunx prisma generate",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "prisma:generate": "bunx prisma generate",
    "prisma:studio": "bunx prisma studio",
    "db:setup:brew": "bash scripts/setup-postgres-brew.sh",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:seed": "bun run prisma/seed.ts",
    "test": "bun test",
    "test:preintegration": "bash scripts/run-preintegration-tests.sh tests/pre-integration",
    "test:preintegration:auth": "bash scripts/run-preintegration-tests.sh tests/pre-integration/auth",
    "check:preintegration": "bun run typecheck && bun run test:preintegration",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "elysia": "^1.3.0",
    "jose": "^6.0.8",
    "nodemailer": "^6.10.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "minio": "^8.0.5",
    "prisma": "^6.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.4.5"
  }
}