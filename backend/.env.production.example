PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://app.elchub.com
FRONTEND_URL=https://app.elchub.com
APP_URL=https://api.elchub.com
DATABASE_URL=postgresql://postgres:change-me@db.example.com:5432/elchub?schema=public
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_TTL=30d
LOG_LEVEL=info
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Elchub <noreply@elchub.com>