generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ORGANIZER
  MENTOR
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  name            String?
  profilePhotoUrl String?
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  organizedEvents     Event[]              @relation("EventOrganizer")
  registrations       EventRegistration[]
  materialProgresses  MaterialProgress[]

  @@map("users")
}

model EventType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([isActive, sortOrder])
  @@map("event_types")
}

model EventTopic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTopics EventTopicMap[]

  @@index([isActive, sortOrder])
  @@map("event_topics")
}

model EventMode {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([isActive, sortOrder])
  @@map("event_modes")
}

model EventLevel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([isActive, sortOrder])
  @@map("event_levels")
}

model EventStatus {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([isActive, sortOrder])
  @@map("event_statuses")
}

model RegistrationStatus {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations EventRegistration[]

  @@index([isActive, sortOrder])
  @@map("registration_statuses")
}

model Event {
  id                  String    @id @default(cuid())
  title               String
  slug                String    @unique
  description         String?
  imageUrl            String?
  meetLink            String?
  startAt             DateTime?
  endAt               DateTime?
  timezone            String?   @default("Asia/Jakarta")
  capacity            Int?
  registrationOpenAt  DateTime?
  registrationCloseAt DateTime?
  organizerId         String
  typeId              String
  modeId              String
  levelId             String?
  statusId            String
  isFree              Boolean   @default(true)
  price               Int?
  formSchema          Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organizer     User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  type          EventType           @relation(fields: [typeId], references: [id], onDelete: Restrict)
  mode          EventMode           @relation(fields: [modeId], references: [id], onDelete: Restrict)
  level         EventLevel?         @relation(fields: [levelId], references: [id], onDelete: SetNull)
  status        EventStatus         @relation(fields: [statusId], references: [id], onDelete: Restrict)
  topics        EventTopicMap[]
  registrations EventRegistration[]
  sections      EventSection[]

  @@index([organizerId])
  @@index([typeId])
  @@index([modeId])
  @@index([levelId])
  @@index([statusId])
  @@index([startAt])
  @@map("events")
}

model EventTopicMap {
  eventId   String
  topicId   String
  createdAt DateTime @default(now())

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  topic EventTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([eventId, topicId])
  @@index([topicId])
  @@map("event_topic_map")
}

model EventRegistration {
  id              String   @id @default(cuid())
  eventId         String
  userId          String
  statusId        String
  customAnswers   Json?
  paymentProofUrl String?
  paymentStatus   String   @default("FREE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status RegistrationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([statusId])
  @@map("event_registrations")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum MaterialType {
  ARTICLE
  VIDEO
  DOCUMENT
  QUIZ
}

model EventSection {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  materials EventMaterial[]

  @@index([eventId])
  @@index([isActive, order])
  @@map("event_sections")
}

model EventMaterial {
  id          String       @id @default(cuid())
  sectionId   String
  title       String
  type        MaterialType
  content     String?      @db.Text
  videoUrl    String?
  fileUrl     String?
  durationMin Int?
  isPreview   Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  section  EventSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress MaterialProgress[]

  @@index([sectionId])
  @@index([type])
  @@map("event_materials")
}

model MaterialProgress {
  id          String    @id @default(cuid())
  userId      String
  materialId  String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  material EventMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
  @@map("material_progress")
}
